generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HistoryEntityType {
  TASK
  CATEGORY
  PROJECT
  DAILY_PLAN_ITEM
  ROUTINE
  CALENDAR_SYNC
  IMPORT
}

enum HistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  SCHEDULED
  RESCHEDULED
  COMPLETED
  SKIPPED
  CANCELLED
  ARCHIVED
  RESTORED
  IMPORTED
  SYNC_SUCCEEDED
  SYNC_FAILED
}

enum DailyPlanItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum TaskKind {
  ONE_TIME
  REUSABLE
}

enum CalendarSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  timezone String @default("America/La_Paz")

  categories                  Category[]
  projects                    Project[]
  tasks                       Task[]
  dailyPlanItems              DailyPlanItem[]
  historyEntries              HistoryEntry[]
  routines                    Routine[]
  routineOccurrenceExclusions RoutineOccurrenceExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id     String @id @default(cuid())
  userId String

  name       String
  color      String?
  isArchived Boolean @default(false)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model Project {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  startDate   DateTime? @db.Date
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  archivedAt  DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Task {
  id         String  @id @default(cuid())
  userId     String
  categoryId String?
  projectId  String?

  title       String   @db.VarChar(200)
  description String?  @db.Text
  kind        TaskKind @default(ONE_TIME)

  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  dueAt            DateTime?
  estimatedMinutes Int?
  completedAt      DateTime?
  archivedAt       DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dailyPlanItems DailyPlanItem[]
  routines       Routine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, priority])
  @@index([categoryId])
  @@index([projectId])
}

model DailyPlanItem {
  id                String  @id @default(cuid())
  userId            String
  taskId            String
  routineScheduleId String?

  plannedDate DateTime @db.Date
  startsAt    DateTime
  endsAt      DateTime

  status   DailyPlanItemStatus @default(PLANNED)
  position Int                 @default(0)
  notes    String?             @db.Text

  routineOccurrenceDate DateTime? @db.Date
  isRoutineException    Boolean   @default(false)

  completedAt DateTime?
  skippedAt   DateTime?
  cancelledAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  routineSchedule RoutineSchedule? @relation(fields: [routineScheduleId], references: [id], onDelete: SetNull)

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  googleCalendarEventId String?
  calendarSyncStatus    CalendarSyncStatus @default(PENDING)
  calendarSyncError     String?            @db.Text
  calendarSyncedAt      DateTime?

  @@unique([routineScheduleId, routineOccurrenceDate])
  @@index([userId, plannedDate, status])
  @@index([userId, startsAt])
  @@index([taskId])
  @@index([routineScheduleId])
}

model Routine {
  id     String @id @default(cuid())
  userId String
  taskId String

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  isActive  Boolean   @default(true)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  schedules RoutineSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive, startDate, endDate])
  @@index([taskId])
}

model RoutineSchedule {
  id        String @id @default(cuid())
  routineId String

  dayOfWeek DayOfWeek
  startTime String    @db.VarChar(5)
  endTime   String    @db.VarChar(5)
  isActive  Boolean   @default(true)

  routine              Routine                      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dailyPlanItems       DailyPlanItem[]
  occurrenceExclusions RoutineOccurrenceExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routineId, dayOfWeek])
  @@index([routineId, isActive])
}

model RoutineOccurrenceExclusion {
  id                String   @id @default(cuid())
  userId            String
  routineScheduleId String
  occurrenceDate    DateTime @db.Date

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineSchedule RoutineSchedule @relation(fields: [routineScheduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([routineScheduleId, occurrenceDate])
  @@index([userId, occurrenceDate])
}

model HistoryEntry {
  id     String @id @default(cuid())
  userId String

  entityType HistoryEntityType
  entityId   String
  action     HistoryAction

  details    Json?
  occurredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([entityType, entityId, occurredAt])
}
