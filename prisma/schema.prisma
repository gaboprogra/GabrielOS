generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HistoryEntityType {
  TASK
  CATEGORY
  PROJECT
  DAILY_PLAN_ITEM
  ROUTINE
  CALENDAR_SYNC
  IMPORT
}

enum HistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  SCHEDULED
  RESCHEDULED
  COMPLETED
  SKIPPED
  CANCELLED
  ARCHIVED
  RESTORED
  IMPORTED
  SYNC_SUCCEEDED
  SYNC_FAILED
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  timezone String @default("America/La_Paz")

  categories     Category[]
  projects       Project[]
  tasks          Task[]
  historyEntries HistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id     String @id @default(cuid())
  userId String

  name       String
  color      String?
  isArchived Boolean @default(false)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model Project {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  startDate   DateTime? @db.Date
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  archivedAt  DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Task {
  id         String  @id @default(cuid())
  userId     String
  categoryId String?
  projectId  String?

  title       String  @db.VarChar(200)
  description String? @db.Text

  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  dueAt            DateTime?
  estimatedMinutes Int?
  completedAt      DateTime?
  archivedAt       DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, priority])
  @@index([categoryId])
  @@index([projectId])
}

model HistoryEntry {
  id     String @id @default(cuid())
  userId String

  entityType HistoryEntityType
  entityId   String
  action     HistoryAction

  details    Json?
  occurredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([entityType, entityId, occurredAt])
}
